# .env.example — exhaustive and committed (CONVENTIONS.md "Config").
# Every variable config.ts parses appears here. Boot crashes naming any missing field.
#
# LabelLoop boots with ZERO required secrets (ADR-0009): every value below either has a
# working local default or is optional. Each phase of the M0 plan appends its own vars.

# ---------- P0: repo genesis ----------
# (no runtime configuration yet — application config lands in P2)

# ---------- P2: apps/api boots ----------
# Runtime mode. One of: development | test | production.
NODE_ENV=development

# Port the API listens on. 0 means "let the OS choose a free one" (used by tests).
PORT=3000

# pino level. One of: trace | debug | info | warn | error | fatal | silent.
# Logs are raw NDJSON on stdout — pipe through `pino-pretty` locally, never a transport.
LOG_LEVEL=info

# Build provenance (ADR-0011). Injected as container build args in CI from the
# release-please version and the built commit; they surface on /healthz and, from P6,
# as `service.version` on every span. The dev placeholders below are REJECTED at boot
# when NODE_ENV=production, because an image that cannot say what it is defeats the
# point of tagging it.
APP_VERSION=0.0.0-dev
GIT_SHA=unknown

# Error reporting sink (ADR-0007). Leave UNSET for local development: the reporter
# becomes a no-op and the Sentry SDK is never even imported (zero-secret boot, ADR-0009).
# SENTRY_DSN=

# ---------- P3: packages/db ----------
# The APP role's connection — DML only, and what the API connects with. This is the first
# REQUIRED variable: it has no default, because a localhost fallback would let a
# misconfigured production deploy boot successfully and talk to nothing.
#
# The value below matches what `infra/docker-compose.yml` starts, so `cp .env.example .env`
# is the whole local setup. `localdev` is a placeholder, not a secret.
#
# There is ONE .env, at the repo root. Bun resolves `.env` from the working directory, so
# the api scripts name this file explicitly (`--env-file=../../.env`) rather than each
# workspace keeping its own copy to drift out of sync. A missing file is tolerated, which
# is what lets the container take its configuration from compose instead.
DATABASE_URL=postgres://labelloop_app:localdev@localhost:5433/labelloop

# Connection pool ceiling for the app role.
DATABASE_POOL_MAX=10

# The MIGRATOR role's connection — DDL, owns the schema, runs `bun run db:migrate`.
# Read only by the migration scripts. The API's own config schema cannot express it, so a
# running API physically cannot alter its schema whatever a bug asks it to.
DATABASE_MIGRATION_URL=postgres://labelloop_migrator:localdev@localhost:5433/labelloop

# A SUPERUSER connection, used by `bun run db:bootstrap` and by nothing else, ever. Its
# one job is CREATE ROLE, which neither of the roles above may do for itself.
DATABASE_ADMIN_URL=postgres://postgres:localdev@localhost:5433/labelloop

# Compose knobs. Both have working defaults in infra/docker-compose.yml; set them only to
# move the published port again or to give the local database a real password. The port
# defaults to 5433 because 5432 is usually already taken by a local Postgres, and that
# collision is silent — see the comment in infra/docker-compose.yml.
# POSTGRES_PORT=5433
# POSTGRES_SUPERUSER_PASSWORD=localdev

# ---------- P5: the queue (pg-boss, on the same Postgres — ADR-0006) ----------
# The queue's own connection pool, which is a SECOND claim on Postgres's max_connections.
# pg-boss polls on a timer and holds a connection while it fetches, so it gets its own pool
# rather than competing with the request path for DATABASE_POOL_MAX above. Small on purpose:
# the number Postgres cares about is (DATABASE_POOL_MAX + QUEUE_POOL_MAX) x replicas.
#
# There is no connection string of its own. The queue connects as the APP role, on the URL
# above, and holds DML only — `bun run db:migrate` installs and upgrades pg-boss's schema as
# the MIGRATOR, because a role that can install a schema is a role with DDL.
QUEUE_POOL_MAX=2
