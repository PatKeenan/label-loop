# .env.example — exhaustive and committed (CONVENTIONS.md "Config").
# Every variable config.ts parses appears here. Boot crashes naming any missing field.
#
# LabelLoop boots with ZERO required secrets (ADR-0009): every value below either has a
# working local default or is optional. Each phase of the M0 plan appends its own vars.

# ---------- P0: repo genesis ----------
# (no runtime configuration yet — application config lands in P2)

# ---------- P2: apps/api boots ----------
# Runtime mode. One of: development | test | production.
NODE_ENV=development

# Port the API listens on. 0 means "let the OS choose a free one" (used by tests).
PORT=3000

# pino level. One of: trace | debug | info | warn | error | fatal | silent.
# Logs are raw NDJSON on stdout — pipe through `pino-pretty` locally, never a transport.
LOG_LEVEL=info

# Build provenance (ADR-0011). Injected as container build args in CI from the
# release-please version and the built commit; they surface on /healthz and, from P6,
# as `service.version` on every span. The dev placeholders below are REJECTED at boot
# when NODE_ENV=production, because an image that cannot say what it is defeats the
# point of tagging it.
APP_VERSION=0.0.0-dev
GIT_SHA=unknown

# Error reporting sink (ADR-0007). Leave UNSET for local development: the reporter
# becomes a no-op and the Sentry SDK is never even imported (zero-secret boot, ADR-0009).
# SENTRY_DSN=

# ---------- P3: packages/db ----------
# The APP role's connection — DML only, and what the API connects with. This is the first
# REQUIRED variable: it has no default, because a localhost fallback would let a
# misconfigured production deploy boot successfully and talk to nothing.
#
# The value below matches what `infra/docker-compose.yml` starts, so `cp .env.example .env`
# is the whole local setup. `localdev` is a placeholder, not a secret.
#
# There is ONE .env, at the repo root. Bun resolves `.env` from the working directory, so
# the api scripts name this file explicitly (`--env-file=../../.env`) rather than each
# workspace keeping its own copy to drift out of sync. A missing file is tolerated, which
# is what lets the container take its configuration from compose instead.
DATABASE_URL=postgres://labelloop_app:localdev@localhost:5433/labelloop

# Connection pool ceiling for the app role.
DATABASE_POOL_MAX=10

# The MIGRATOR role's connection — DDL, owns the schema, runs `bun run db:migrate`.
# Read only by the migration scripts. The API's own config schema cannot express it, so a
# running API physically cannot alter its schema whatever a bug asks it to.
DATABASE_MIGRATION_URL=postgres://labelloop_migrator:localdev@localhost:5433/labelloop

# A SUPERUSER connection, used by `bun run db:bootstrap` and by nothing else, ever. Its
# one job is CREATE ROLE, which neither of the roles above may do for itself.
DATABASE_ADMIN_URL=postgres://postgres:localdev@localhost:5433/labelloop

# Compose knobs. Both have working defaults in infra/docker-compose.yml; set them only to
# move the published port again or to give the local database a real password. The port
# defaults to 5433 because 5432 is usually already taken by a local Postgres, and that
# collision is silent — see the comment in infra/docker-compose.yml.
# POSTGRES_PORT=5433
# POSTGRES_SUPERUSER_PASSWORD=localdev

# ---------- P5: the queue (pg-boss, on the same Postgres — ADR-0006) ----------
# The queue's own connection pool, which is a SECOND claim on Postgres's max_connections.
# pg-boss polls on a timer and holds a connection while it fetches, so it gets its own pool
# rather than competing with the request path for DATABASE_POOL_MAX above. Small on purpose:
# the number Postgres cares about is (DATABASE_POOL_MAX + QUEUE_POOL_MAX) x replicas.
#
# There is no connection string of its own. The queue connects as the APP role, on the URL
# above, and holds DML only — `bun run db:migrate` installs and upgrades pg-boss's schema as
# the MIGRATOR, because a role that can install a schema is a role with DDL.
QUEUE_POOL_MAX=2

# ---------- P6: telemetry (ADR-0007) ----------
# Where spans go: the OTel Collector's OTLP/HTTP base URL. No `/v1/traces` suffix — the
# exporter appends it. The value below is the collector `infra/docker-compose.yml` starts,
# reached over the published port while the API still runs on the host; from P8 the API is
# a container and compose sets this to `http://otel-collector:4318` on the compose network.
#
# UNSET IS A SUPPORTED STATE, not a degraded one. Without it the tracer provider still runs
# and `request_id` is still a real W3C trace id (ADR-0010) — the spans are simply not sent
# anywhere. So a `docker compose up -d postgres` and nothing else is a working setup; you
# will just see periodic `otel` warn lines saying the collector is unreachable while there
# is traffic. Comment this out if you would rather not.
#
# There is deliberately no default in config.ts, for the same reason DATABASE_URL has none:
# a baked-in localhost would let a production deploy that forgot this variable look healthy
# while every trace went into a void.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Compose knobs, all with working defaults in infra/docker-compose.yml. GRAFANA_PORT is
# 3001 rather than Grafana's own 3000 because 3000 is the API's default and a developer
# running both would collide — the same reasoning that moved Postgres off 5432. The two
# OTLP ports are the collector's; set them only if something else on the machine already
# has 4317/4318.
# GRAFANA_PORT=3001
# OTLP_HTTP_PORT=4318
# OTLP_GRPC_PORT=4317

# ---------- P7: the console (ADR-0008) ----------
# The key better-auth signs and encrypts session material with. Zero-entropy and
# self-describing on purpose: a realistic-looking literal committed here would be
# indistinguishable from a leaked secret, to a scanner and to a reader.
#
# It has a default so a fresh clone boots with no secrets (ADR-0009), and that default is
# REJECTED at boot when NODE_ENV=production — because it is committed, so every session
# signed with it is forgeable by anyone who has read this file. Generate a real one with
# `openssl rand -base64 32`.
#
# Note what this is not: it is nowhere near the /v1 path. Customer API keys are our own
# SHA-256-hashed, panel-scoped credentials (ADR-0003) and never touch better-auth, so
# rotating this logs the console out and changes nothing about an integration.
BETTER_AUTH_SECRET=localdev-not-a-secret

# Where a BROWSER reaches this API. better-auth computes cookie scope and callback URLs
# from it, so it is the origin as the browser sees it, not as the process sees itself —
# behind a proxy those differ, and the browser's is the one that matters.
API_BASE_URL=http://localhost:3000

# Where the console runs. It is both the CORS allow-list and better-auth's trusted origin.
# In development these are two ORIGINS (Vite on 5173, the API on 3000) but one SITE —
# cookies ignore ports — so the session cookie rides along on SameSite=Lax and only CORS
# has to be told. A path or a trailing slash is normalised away, because the browser's
# `Origin` header carries neither and the comparison is byte for byte.
WEB_ORIGIN=http://localhost:5173

# Where apps/web sends its requests. Read by VITE at build time, not by config.ts — Vite
# only exposes variables prefixed VITE_, and it is pointed at this one root .env file by
# `envDir` in apps/web/vite.config.ts, so there is still exactly one .env in the repo.
VITE_API_URL=http://localhost:3000

# The console login the seed creates, so a fresh clone can sign in. A local account on a
# throwaway database, printed by `bun run db:seed` and quoted in the README. Read by the
# seed script only; the API never sees either value.
SEED_USER_EMAIL=demo@labelloop.test
SEED_USER_PASSWORD=localdev-password
